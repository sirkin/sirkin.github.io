               <rdf:li rdf:parseType="Resource">
                  <pdfaSchema:schema>Springer Nature ORCID Schema</pdfaSchema:schema>
                  <pdfaSchema:namespaceURI>http://springernature.com/ns/xmpExtensions/2.0/</pdfaSchema:namespaceURI>
                  <pdfaSchema:prefix>sn</pdfaSchema:prefix>
                  <pdfaSchema:property>
                     <rdf:Seq>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaProperty:name>authorInfo</pdfaProperty:name>
                           <pdfaProperty:valueType>Bag AuthorInformation</pdfaProperty:valueType>
                           <pdfaProperty:category>external</pdfaProperty:category>
                           <pdfaProperty:description>Author information: contains the name of each author and his/her ORCiD (ORCiD: Open Researcher and Contributor ID). An ORCiD is a persistent identifier (a non-proprietary alphanumeric code) to uniquely identify scientific and other academic authors.</pdfaProperty:description>
                        </rdf:li>
                     </rdf:Seq>
                  </pdfaSchema:property>
                  <pdfaSchema:valueType>
                     <rdf:Seq>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaType:type>AuthorInformation</pdfaType:type>
                           <pdfaType:namespaceURI>http://springernature.com/ns/xmpExtensions/2.0/authorInfo/</pdfaType:namespaceURI>
                           <pdfaType:prefix>author</pdfaType:prefix>
                           <pdfaType:description>Specifies the types of author information: name and ORCID of an author.</pdfaType:description>
                           <pdfaType:field>
                              <rdf:Seq>
                                 <rdf:li rdf:parseType="Resource">
                                    <pdfaField:name>name</pdfaField:name>
                                    <pdfaField:valueType>Text</pdfaField:valueType>
                                    <pdfaField:description>Gives the name of an author.</pdfaField:description>
                                 </rdf:li>
                                 <rdf:li rdf:parseType="Resource">
                                    <pdfaField:name>orcid</pdfaField:name>
                                    <pdfaField:valueType>URI</pdfaField:valueType>
                                    <pdfaField:description>Gives the ORCID of an author.</pdfaField:description>
                                 </rdf:li>
                              </rdf:Seq>
                           </pdfaType:field>
                        </rdf:li>
                     </rdf:Seq>
                  </pdfaSchema:valueType>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <pdfaSchema:namespaceURI>http://iptc.org/std/Iptc4xmpExt/2008-02-29/</pdfaSchema:namespaceURI>
                  <pdfaSchema:prefix>Iptc4xmpExt</pdfaSchema:prefix>
                  <pdfaSchema:schema>IPTC Extension</pdfaSchema:schema>
                  <pdfaSchema:property>
                     <rdf:Seq>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaProperty:category>external</pdfaProperty:category>
                           <pdfaProperty:description>A set of metadata about artwork or an object in the item.</pdfaProperty:description>
                           <pdfaProperty:name>ArtworkOrObject</pdfaProperty:name>
                           <pdfaProperty:valueType>Bag ArtworkOrObjectDetails</pdfaProperty:valueType>
                        </rdf:li>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaProperty:category>external</pdfaProperty:category>
                           <pdfaProperty:description>The location the content of the item was created.</pdfaProperty:description>
                           <pdfaProperty:name>LocationCreated</pdfaProperty:name>
                           <pdfaProperty:valueType>Bag LocationDetails</pdfaProperty:valueType>
                        </rdf:li>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaProperty:category>external</pdfaProperty:category>
                           <pdfaProperty:description>A location the content of the item is about. For photos that is a location shown in the image.</pdfaProperty:description>
                           <pdfaProperty:name>LocationShown</pdfaProperty:name>
                           <pdfaProperty:valueType>Bag LocationDetails</pdfaProperty:valueType>
                        </rdf:li>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaProperty:category>external</pdfaProperty:category>
                           <pdfaProperty:description>Both a Registry Item Id and a Registry Organisation Id to record any registration of this item with a registry.</pdfaProperty:description>
                           <pdfaProperty:name>RegistryId</pdfaProperty:name>
                           <pdfaProperty:valueType>RegistryEntryDetails</pdfaProperty:valueType>
                        </rdf:li>
                     </rdf:Seq>
                  </pdfaSchema:property>
                  <pdfaSchema:valueType>
                     <rdf:Seq>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaType:description>A structured datatype for details about artwork or an object in an image</pdfaType:description>
                           <pdfaType:namespaceURI>http://iptc.org/std/Iptc4xmpExt/2008-02-29/</pdfaType:namespaceURI>
                           <pdfaType:prefix>Iptc4xmpExt</pdfaType:prefix>
                           <pdfaType:type>ArtworkOrObjectDetails</pdfaType:type>
                        </rdf:li>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaType:description>A structured datatype for details of a location</pdfaType:description>
                           <pdfaType:namespaceURI>http://iptc.org/std/Iptc4xmpExt/2008-02-29/</pdfaType:namespaceURI>
                           <pdfaType:prefix>Iptc4xmpExt</pdfaType:prefix>
                           <pdfaType:type>LocationDetails</pdfaType:type>
                        </rdf:li>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaType:description>A structured datatype for an entry in a registry, includes the id issued by the registry and the registry's id.</pdfaType:description>
                           <pdfaType:namespaceURI>http://iptc.org/std/Iptc4xmpExt/2008-02-29/</pdfaType:namespaceURI>
                           <pdfaType:prefix>Iptc4xmpExt</pdfaType:prefix>
                           <pdfaType:type>RegistryEntryDetails</pdfaType:type>
                        </rdf:li>
                     </rdf:Seq>
                  </pdfaSchema:valueType>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <pdfaSchema:namespaceURI>http://ns.useplus.org/ldf/xmp/1.0/</pdfaSchema:namespaceURI>
                  <pdfaSchema:prefix>plus</pdfaSchema:prefix>
                  <pdfaSchema:schema>PLUS LDF Version 1.2.0</pdfaSchema:schema>
                  <pdfaSchema:property>
                     <rdf:Seq>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaProperty:category>external</pdfaProperty:category>
                           <pdfaProperty:description>Owner or owners of the copyright in the licensed image.</pdfaProperty:description>
                           <pdfaProperty:name>CopyrightOwner</pdfaProperty:name>
                           <pdfaProperty:valueType>Seq CopyrightOwnerDetail</pdfaProperty:valueType>
                        </rdf:li>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaProperty:category>external</pdfaProperty:category>
                           <pdfaProperty:description>Creator/s of the image.</pdfaProperty:description>
                           <pdfaProperty:name>ImageCreator</pdfaProperty:name>
                           <pdfaProperty:valueType>Seq ImageCreatorDetail</pdfaProperty:valueType>
                        </rdf:li>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaProperty:category>external</pdfaProperty:category>
                           <pdfaProperty:description>Party providing the image to the Licensor or to the Licensee on behalf of the Licensor.</pdfaProperty:description>
                           <pdfaProperty:name>ImageSupplier</pdfaProperty:name>
                           <pdfaProperty:valueType>Seq ImageSupplierDetail</pdfaProperty:valueType>
                        </rdf:li>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaProperty:category>external</pdfaProperty:category>
                           <pdfaProperty:description>Party or parties granting the license to the Licensee.</pdfaProperty:description>
                           <pdfaProperty:name>Licensor</pdfaProperty:name>
                           <pdfaProperty:valueType>Seq LicensorDetail</pdfaProperty:valueType>
                        </rdf:li>
                     </rdf:Seq>
                  </pdfaSchema:property>
                  <pdfaSchema:valueType>
                     <rdf:Seq>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaType:description>&lt;DESCRIPTION&gt;</pdfaType:description>
                           <pdfaType:namespaceURI>http://ns.useplus.org/ldf/xmp/1.0/</pdfaType:namespaceURI>
                           <pdfaType:prefix>plus</pdfaType:prefix>
                           <pdfaType:type>CopyrightOwnerDetail</pdfaType:type>
                        </rdf:li>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaType:description>&lt;DESCRIPTION&gt;</pdfaType:description>
                           <pdfaType:namespaceURI>http://ns.useplus.org/ldf/xmp/1.0/</pdfaType:namespaceURI>
                           <pdfaType:prefix>plus</pdfaType:prefix>
                           <pdfaType:type>ImageCreatorDetail</pdfaType:type>
                        </rdf:li>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaType:description>&lt;DESCRIPTION&gt;</pdfaType:description>
                           <pdfaType:namespaceURI>http://ns.useplus.org/ldf/xmp/1.0/</pdfaType:namespaceURI>
                           <pdfaType:prefix>plus</pdfaType:prefix>
                           <pdfaType:type>ImageSupplierDetail</pdfaType:type>
                        </rdf:li>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaType:description>&lt;DESCRIPTION&gt;</pdfaType:description>
                           <pdfaType:namespaceURI>http://ns.useplus.org/ldf/xmp/1.0/</pdfaType:namespaceURI>
                           <pdfaType:prefix>plus</pdfaType:prefix>
                           <pdfaType:type>LicensorDetail</pdfaType:type>
                        </rdf:li>
                     </rdf:Seq>
                  </pdfaSchema:valueType>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <pdfaSchema:namespaceURI>http://www.niso.org/schemas/jav/1.0/</pdfaSchema:namespaceURI>
                  <pdfaSchema:prefix>jav</pdfaSchema:prefix>
                  <pdfaSchema:schema>NISO</pdfaSchema:schema>
                  <pdfaSchema:property>
                     <rdf:Seq>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaProperty:category>external</pdfaProperty:category>
                           <pdfaProperty:description>Values for Journal Article Version are one of the following:
AO = Authorâ€™s Original
SMUR = Submitted Manuscript Under Review
AM = Accepted Manuscript
P = Proof
VoR = Version of Record
CVoR = Corrected Version of Record
EVoR = Enhanced Version of Record</pdfaProperty:description>
                           <pdfaProperty:name>journal_article_version</pdfaProperty:name>
                           <pdfaProperty:valueType>Closed Choice of Text</pdfaProperty:valueType>
                        </rdf:li>
                     </rdf:Seq>
                  </pdfaSchema:property>
               </rdf:li>
            </rdf:Bag>
         </pdfaExtension:schemas>
      </rdf:Description>
   </rdf:RDF>
